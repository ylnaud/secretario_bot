# 🤖 BOT TOKEN DE TELEGRAM
# Obtén este token de @BotFather en Telegram
# Pasos: @BotFather → /newbot → copia el token
BOT_TOKEN=7123456789:ABCDEFGHijklmnopqrstuvwxyz_1a2b3c4d5e6f7g8h9i0j

# 👤 TU USER ID DE TELEGRAM
# Obtén este ID de @userinfobot en Telegram
# Pasos: @userinfobot → /start → copia tu ID
# El bot solo responderá a este usuario
OWNER_ID=987654321

# 🗄️ URL DE BASE DE DATOS POSTGRESQL
# El bot y la Mini App COMPARTEN esta base de datos.
# Usa exactamente el mismo valor aquí y en Vercel, o cada uno
# guardará las tareas en un sitio distinto y no se verán entre sí.
#
# Opciones:
# - Neon (gratuito): https://neon.tech
# - Supabase (gratuito): https://supabase.com
# - Railway (pago): https://railway.app
# Formato: postgresql://usuario:contraseña@host:puerto/basedatos?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/secretario?sslmode=require

# ⏰ CADA CUÁNTO SE COMPRUEBAN LOS RECORDATORIOS (milisegundos)
# Por defecto: 30000 (30 segundos)
# Súbelo para gastar menos batería en Termux, bájalo para más precisión.
REMINDER_INTERVAL_MS=30000

# 🌐 URL PÚBLICA DE LA MINI APP
# Usa cuando desplegues a Vercel o tu servidor
# Ejemplo Vercel: https://tu-proyecto.vercel.app
MINI_APP_URL=http://localhost:3000

# 📡 PUERTO DEL SERVIDOR (opcional)
# Por defecto: 3000
PORT=3000
