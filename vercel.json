{
  "version": 2,

  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "miniapp/**",
      "use": "@vercel/static"
    }
  ],

  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js?path=$1"
    },
    {
      "src": "/api",
      "dest": "/api/index.js?path="
    },
    {
      "src": "/",
      "dest": "/miniapp/index.html"
    },
    {
      "src": "/miniapp/(.*)",
      "dest": "/miniapp/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/miniapp/$1"
    }
  ]
}
